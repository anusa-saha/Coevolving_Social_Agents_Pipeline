# ---- results ---------------------------------------------------------------
# Records, checkpoints and generated reports are outputs, not source. They are
# archived outside the repo; point CSA_ARTIFACTS_DIR at that archive to let the
# selftests and the metrics scripts read them.
*/logs/
*/ckpt/
*/data/
!ppdpp/data/
*.pdf
extended_metrics.json

# ---- dataset ---------------------------------------------------------------
# Fetched from the Hub on first use by csa_core.paths.download_raw().
data/raw/

# ---- python ----------------------------------------------------------------
__pycache__/
*.py[cod]
.Python
build/
dist/
*.egg-info/
.eggs/
.venv/
venv/
env/

# ---- tooling ---------------------------------------------------------------
.ipynb_checkpoints/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# ---- editors / os ----------------------------------------------------------
.vscode/
.idea/
*.swp
.DS_Store
Thumbs.db

# ---- never ------------------------------------------------------------------
.env
*.key
